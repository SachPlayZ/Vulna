{
  "name": "vulna",
  "version": "1.0.0",
  "type": "module",
  "description": "A Midnight Network application created with create-mn-app",
  "author": "",
  "license": "MIT",
  "scripts": {
    "compile": "compact compile contracts/hello-world.compact contracts/managed/hello-world",
    "dev": "next dev",
    "sync:zk": "mkdir -p public/contract/hello-world && cp -R contracts/managed/hello-world/keys contracts/managed/hello-world/zkir public/contract/hello-world/",
    "build": "pnpm run sync:zk && next build --webpack",
    "start": "next start",
    "typecheck": "npx tsc --noEmit",
    "build:protocol": "npx tsc --noEmit",
    "setup": "npx tsx src/setup.ts",
    "deploy": "npx tsx scripts/phase6-settlement-flow.ts",
    "deploy:v2:preview": "npx tsx scripts/deploy-v2-preview.ts",
    "cli": "npx tsx src/cli.ts",
    "check-balance": "npx tsx src/check-balance.ts",
    "network": "npx tsx src/network.ts",
    "proof-server:start": "docker compose up -d",
    "proof-server:stop": "docker compose down",
    "clean": "rm -rf contracts/managed .midnight-state.json .midnight-wallet-state",
    "test": "pnpm run test:protocol && pnpm run test:contract",
    "test:protocol": "tsx --test src/*.test.ts src/protocol/*.test.ts src/crypto/*.test.ts src/storage/*.test.ts src/web/*.test.ts",
    "test:ci": "tsx --test src/protocol/*.test.ts src/crypto/*.test.ts src/storage/*.test.ts src/web/*.test.ts",
    "test:contract": "pnpm run compile && node --test scripts/contract-simulator.test.mjs",
    "test:integration": "pnpm run compile && pnpm run deploy",
    "test:settlement-spike": "tsx scripts/token-transfer-spike.ts",
    "test:e2e": "tsx scripts/e2e-check.ts",
    "test:web": "pnpm run build && playwright test",
    "record:demo": "pnpm run build && PW_VIDEO=1 playwright test"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/dapp-connector-api": "4.0.1",
    "@midnight-ntwrk/ledger-v8": "8.1.0",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-fetch-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@midnight-ntwrk/midnight-js-utils": "4.1.1",
    "@midnight-ntwrk/wallet-sdk": "1.2.0",
    "@vercel/blob": "^2.6.1",
    "gsap": "^3.15.0",
    "libsodium-wrappers-sumo": "0.8.4",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.83.0",
    "rxjs": "^7.8.2",
    "ws": "^8.21.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "postcss": "^8.5.23",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "midnight",
    "blockchain",
    "zero-knowledge",
    "privacy"
  ]
}
